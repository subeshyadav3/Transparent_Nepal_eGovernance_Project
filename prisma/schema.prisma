generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

////////////////////
/// USER & ROLE ///
////////////////////

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(CITIZEN)
  kycVerified Boolean  @default(false)
  createdAt   DateTime @default(now())

  comments   Comment[]
  complaints Complaint[]
}

enum Role {
  ADMIN
  CITIZEN
}

////////////////////
/// DEPARTMENT  ///
////////////////////

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  fiscalYear  String
  createdAt   DateTime @default(now())

  budgets Budget[]
}

////////////////////
/// BUDGET      ///
////////////////////

model Budget {
  id              String   @id @default(uuid())
  departmentId    String
  fiscalYear      String
  allocatedAmount Decimal
  spentAmount     Decimal  @default(0)
  remainingAmount Decimal  @default(0)
  lastUpdated     DateTime @updatedAt

  department   Department          @relation(fields: [departmentId], references: [id])
  projects     Project[]
  transactions BudgetTransaction[]
}

////////////////////
/// PROJECT     ///
////////////////////

model Project {
  id           String        @id @default(cuid())
  projectName  String
  description  String
  status       ProjectStatus
  progress     Int
  totalCost    Float
  startDate    DateTime
  endDate      DateTime
  budgetId     String
  budget       Budget        @relation(fields: [budgetId], references: [id])
  contractorId String
  contractor   Contractor    @relation(fields: [contractorId], references: [id])
  upvotes      Int           @default(0)
  downvotes    Int           @default(0)

  projectReports     ProjectReport[]
  rescheduleLogs     RescheduleLog[]
  complaints         Complaint[]
  comments           Comment[]
  budgetTransactions BudgetTransaction[]
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
}

////////////////////
/// CONTRACTOR  ///
////////////////////

model Contractor {
  id             String @id @default(uuid())
  companyName    String
  registrationNo String
  contactPerson  String
  phone          String
  email          String
  score          Float?

  projects Project[]
}

////////////////////
/// COMMENTS   ///
////////////////////

model Comment {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  message   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

////////////////////
/// COMPLAINTS ///
////////////////////

model Complaint {
  id          String          @id @default(uuid())
  projectId   String
  userId      String
  title       String
  description String
  status      ComplaintStatus @default(SUBMITTED)
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  RESOLVED
}

////////////////////
/// REPORTS     ///
////////////////////

model ProjectReport {
  id        String   @id @default(uuid())
  projectId String
  title     String
  summary   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

////////////////////
/// RESCHEDULE ///
////////////////////

model RescheduleLog {
  id        String   @id @default(uuid())
  projectId String
  oldDate   DateTime
  newDate   DateTime
  reason    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

////////////////////
/// TRANSACTION ///
////////////////////

model BudgetTransaction {
  id              String   @id @default(uuid())
  budgetId        String
  projectId       String?
  amount          Decimal
  transactionDate DateTime
  remarks         String?
  createdAt       DateTime @default(now())

  budget  Budget   @relation(fields: [budgetId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
}
